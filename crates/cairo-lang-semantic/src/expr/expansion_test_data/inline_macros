// Nothing in the matcher or the expansion is specific to the two separators a rule is usually
// written with: `|` is matched and emitted exactly as it is written. The captures are `ident`s
// because `|` is not one of the tokens an `expr` capture may be followed by. `rustc` expands the
// same macro and call to `A | B` and prints `3`.
const A: u8 = 1;

const B: u8 = 2;

#[feature("user_defined_inline_macros")]
macro bits {
    ($($x:ident)|*) => { $($x)|* };
}

