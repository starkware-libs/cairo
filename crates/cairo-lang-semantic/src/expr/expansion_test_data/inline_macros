//! > Test a `;`-separated repetition matching no input at all.

//! > test_runner_name
test_expand_expr(expect_diagnostics: false)

//! > module_code
// The empty list matches with no groups, so no separator is either consumed or emitted for it. The
// two-group list beside it, in the same call, is what shows the rule does declare a separator -
// alone, an empty list would match a rule that ignores its separator just as well. `rustc` expands
// the same macro and call to `((), (A, B))` and prints `((), (1, 2))`.
const A: felt252 = 1;

const B: felt252 = 2;

#[feature("user_defined_inline_macros")]
macro parts {
    ([$($x:ident);*] [$($y:ident);*]) => { (($($x),*), ($($y),*)) };
}

//! > expr_code
let expanded = parts!([] [A; B]);

//! > expanded_code
expanded: ((), (A,B))

