//! > Test a nested repetition whose outer groups a `;` separates.

//! > test_runner_name
test_expand_expr(expect_diagnostics: false)

//! > module_code
// This shape is only expressible once a separator may be something other than a comma: the inner
// repetition juxtaposes its captures, so the outer one needs a separator of its own to tell one
// group of the call from the next. Two captures per group and two outer groups, so both levels
// really repeat. `rustc` expands the same macro and call to `((A, B), (C, D))` and prints
// `((1, 2), (4, 8))`.
const A: felt252 = 1;

const B: felt252 = 2;

const C: felt252 = 4;

const D: felt252 = 8;

#[feature("user_defined_inline_macros")]
macro nested {
    ($($($x:ident)+);*) => { ($(($($x),+)),*) };
}

//! > expr_code
let expanded = nested!(A B; C D);

//! > expanded_code
expanded: ((A,B),(C,D))

